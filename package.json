{
  "name": "sahin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --aggregate-output dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis",
    "db:generate": "pnpm -F @sahin/db generate",
    "db:migrate": "pnpm -F @sahin/db migrate",
    "db:studio": "pnpm -F @sahin/db studio",
    "setup:armut": "pnpm -F @sahin/worker setup:armut",
    "setup:upwork": "pnpm -F @sahin/worker setup:upwork"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
